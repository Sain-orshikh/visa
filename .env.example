# MongoDB — required. A connection string that includes the database name,
# e.g. mongodb+srv://user:pass@cluster0.mongodb.net/visa_tracker
MONGODB_URI=

# Optional: overrides the database name if it isn't in the URI's path.
# MONGODB_DB=visa_tracker

# Cloudinary — this deployment's shared storage, offered to users as the
# "Visa Tracker storage" option. Leave it blank and users must connect their
# own cloud in Settings → Storage before they can upload. Either the single URL:
CLOUDINARY_URL=

# ...or the three discrete values (used only if CLOUDINARY_URL is unset):
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Google Drive — optional. Set both to offer "your own Google Drive" as a
# storage option. Create an OAuth 2.0 Web application client in the Google
# Cloud console with the Drive API enabled, and register the redirect URI
# <your-origin>/api/storage/google/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: pins the OAuth redirect and post-connect redirect to one origin.
# Set this on any deployment with preview URLs, e.g. https://visa.example.com
# APP_URL=

# Signs session cookies, and derives the key that encrypts the storage
# credentials users hand us. Set a long random value in production — changing
# it logs everyone out and invalidates saved storage credentials.
SESSION_SECRET=
